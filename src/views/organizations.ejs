<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are a few of our partner organizations:</p>

        <ul>
            <% organizations.forEach(org=> { %>
                <li><img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">

                    <a href="/organization/<%= org.organization_id %>">
                        <strong>
                            <%= org.name %>
                        </strong>
                    </a>

                    : <%= org.contact_email %>
                </li>
                <% }) %>
        </ul>
        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-organization">Add a new organization</a>
                <% } %>
        </p>
    </main>
    <%- include('partials/footer') %>