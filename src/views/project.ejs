<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.project_date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <!-- CATEGORY TAGS (NEW REQUIREMENT) -->
        <section class="project-categories">
            <h3>Categories</h3>

            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag">
                        <%= category.name %>
                    </a>
                    <% }) %>
                        <% } else { %>
                            <p>No categories assigned.</p>
                            <% } %>
        </section>
        <!-- VOLUNTEER SECTION -->
        <% if (user) { %>
            <% if (!userIsVolunteer) { %>
                <form method="POST" action="/project/<%= project.project_id %>/volunteer">
                    <button type="submit">
                        Volunteer for this Project
                    </button>
                </form>
                <% } else { %>
                    <p><strong>You are volunteering for this project.</strong></p>
                    <form method="POST" action="/project/<%= project.project_id %>/unvolunteer">
                        <button type="submit">
                            Remove Volunteer
                        </button>
                    </form>
                    <% } %>
                        <% } %>
                            <p>
                                <% if (user && user.role_name==='admin' ) { %>
                                    <a href="/edit-project/<%= project.project_id %>">
                                        Edit Project
                                    </a>
                                    <% } %>
                            </p>
                            <p>
                                <a href="/assign-categories/<%= project.project_id %>">
                                    Edit Categories
                                </a>
                            </p>
    </main>

    <%- include('partials/footer') %>